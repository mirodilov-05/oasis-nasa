# Copy to .env (never commit .env). Every key is optional; without it the matching
# data source reports itself as unavailable instead of inventing data.

# NASA Earthdata bearer token: SMAP, GPM IMERG, GLDAS, MODIS, HLS, ECOSTRESS observations
EARTHDATA_TOKEN=

# USDA NASS QuickStats key: US county yields
NASS_API_KEY=

# OpenET key: western-US actual evapotranspiration
OPENET_API_KEY=

# Enables editing data sources in the site (sent as the X-Admin-Token header)
# ADMIN_TOKEN=

# Max distance (km) to borrow a cached NASA POWER point when the live request fails
# FALLBACK_MAX_KM=150
